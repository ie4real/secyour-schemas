{
  "$metadata": {
    "type": "ProfileGovernmentIds",
    "uris": {
      "jsonLdContext": "https://raw.githubusercontent.com/ie4real/secyour-schemas/master/schemas/ProfileGovernmentIds.jsonld"
    },
    "version": "1.0"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileGovernmentIds",
  "description": "The user's own government identifiers (tax id and issuing country). attestation says who vouches for them: 'self-declared' = typed by the user; 'partner-verified' = checked by a verification partner.",
  "type": "object",
  "properties": {
    "@context": {
      "type": ["string", "array", "object"]
    },
    "id": {
      "type": "string"
    },
    "issuanceDate": {
      "format": "date-time",
      "type": "string"
    },
    "expirationDate": {
      "format": "date-time",
      "type": "string"
    },
    "issuer": {
      "type": ["string", "object"],
      "format": "uri",
      "properties": {
        "id": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": ["id"]
    },
    "type": {
      "type": ["string", "array"],
      "items": {
        "type": "string"
      }
    },
    "credentialSubject": {
      "title": "Credential subject",
      "description": "The person these values describe",
      "type": "object",
      "properties": {
        "id": {
          "title": "Credential subject ID",
          "description": "DID of the subject",
          "format": "uri",
          "type": "string"
        },
        "taxId": {
          "title": "taxId",
          "description": "Tax identification number",
          "type": "string"
        },
        "taxCountry": {
          "title": "taxCountry",
          "description": "Country that issued the tax id, ISO 3166-1 alpha-3",
          "type": "string"
        },
        "attestation": {
          "title": "attestation",
          "description": "self-declared | partner-verified | chip-verified",
          "type": "string"
        }
      },
      "required": ["taxId", "taxCountry", "attestation"]
    },
    "credentialSchema": {
      "type": "object",
      "properties": {
        "id": {
          "format": "uri",
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": ["id", "type"]
    }
  },
  "required": ["@context", "id", "issuanceDate", "issuer", "type", "credentialSubject", "credentialSchema"]
}
