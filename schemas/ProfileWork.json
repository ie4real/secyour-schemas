{
  "$metadata": {
    "type": "ProfileWork",
    "uris": {
      "jsonLdContext": "https://raw.githubusercontent.com/ie4real/secyour-schemas/master/schemas/ProfileWork.jsonld"
    },
    "version": "1.0"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileWork",
  "description": "The user's own work values (employer, job title, work email, work address). attestation says who vouches for them: 'self-declared' = typed by the user; 'partner-verified' = checked by a verification partner.",
  "type": "object",
  "properties": {
    "@context": {
      "type": ["string", "array", "object"]
    },
    "id": {
      "type": "string"
    },
    "issuanceDate": {
      "format": "date-time",
      "type": "string"
    },
    "expirationDate": {
      "format": "date-time",
      "type": "string"
    },
    "issuer": {
      "type": ["string", "object"],
      "format": "uri",
      "properties": {
        "id": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": ["id"]
    },
    "type": {
      "type": ["string", "array"],
      "items": {
        "type": "string"
      }
    },
    "credentialSubject": {
      "title": "Credential subject",
      "description": "The person these values describe",
      "type": "object",
      "properties": {
        "id": {
          "title": "Credential subject ID",
          "description": "DID of the subject",
          "format": "uri",
          "type": "string"
        },
        "employer": {
          "title": "employer",
          "description": "Employer name",
          "type": "string"
        },
        "jobTitle": {
          "title": "jobTitle",
          "description": "Job title",
          "type": "string"
        },
        "workEmail": {
          "title": "workEmail",
          "description": "Work email address",
          "type": "string"
        },
        "workStreet": {
          "title": "workStreet",
          "description": "Work street address",
          "type": "string"
        },
        "workCity": {
          "title": "workCity",
          "description": "Work city",
          "type": "string"
        },
        "workRegion": {
          "title": "workRegion",
          "description": "Work state / province / region",
          "type": "string"
        },
        "workPostalCode": {
          "title": "workPostalCode",
          "description": "Work postal code",
          "type": "string"
        },
        "workCountry": {
          "title": "workCountry",
          "description": "Work country",
          "type": "string"
        },
        "attestation": {
          "title": "attestation",
          "description": "self-declared | partner-verified | chip-verified",
          "type": "string"
        }
      },
      "required": ["attestation"]
    },
    "credentialSchema": {
      "type": "object",
      "properties": {
        "id": {
          "format": "uri",
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": ["id", "type"]
    }
  },
  "required": ["@context", "id", "issuanceDate", "issuer", "type", "credentialSubject", "credentialSchema"]
}
