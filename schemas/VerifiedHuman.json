{
  "$metadata": {
    "type": "VerifiedHuman",
    "uris": {
      "jsonLdContext": "https://raw.githubusercontent.com/ie4real/secyour-schemas/master/schemas/VerifiedHuman.jsonld"
    },
    "version": "1.0"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifiedHuman",
  "description": "A verification partner confirmed that a live human took a selfie on the date in checkedAt. No image or biometric data is in this credential.",
  "type": "object",
  "properties": {
    "@context": { "type": ["string", "array", "object"] },
    "id": { "type": "string" },
    "issuanceDate": { "format": "date-time", "type": "string" },
    "expirationDate": { "format": "date-time", "type": "string" },
    "issuer": {
      "type": ["string", "object"],
      "format": "uri",
      "properties": { "id": { "format": "uri", "type": "string" } },
      "required": ["id"]
    },
    "type": { "type": ["string", "array"], "items": { "type": "string" } },
    "credentialSubject": {
      "title": "Credential subject",
      "description": "The person who passed the check",
      "type": "object",
      "properties": {
        "id": {
          "title": "Credential subject ID",
          "description": "DID of the subject",
          "format": "uri",
          "type": "string"
        },
        "attestation": {
          "title": "attestation",
          "description": "self-declared | partner-verified | chip-verified",
          "type": "string"
        },
        "checkedAt": {
          "title": "checkedAt",
          "description": "Date of the liveness check, yyyymmdd (UTC)",
          "type": "integer"
        },
        "livenessScore": {
          "title": "livenessScore",
          "description": "Partner confidence that a live human was present, 0-100",
          "type": "integer"
        }
      },
      "required": ["attestation", "checkedAt", "livenessScore"]
    },
    "credentialSchema": {
      "type": "object",
      "properties": {
        "id": { "format": "uri", "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "type"]
    }
  },
  "required": ["@context", "id", "issuanceDate", "issuer", "type", "credentialSubject", "credentialSchema"]
}
